{
	"name": "@inkfinite/bindings",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsc -p tsconfig.json",
