{
	"name": "@inkfinite/ui",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"build": "pnpm icons:generate && svelte-kit sync && svelte-package",
		"build:workshop": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"dev": "vite dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"icons:generate": "node scripts/generate-icons.mjs",
		"playwright": "playwright test",
		"prepare": "svelte-kit sync",
		"preview": "vite preview",
		"storybook": "storybook dev -p 6006",
		"storybook:build": "storybook build",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./editor": {
			"types": "./dist/editor/index.d.ts",
			"svelte": "./dist/editor/index.js",
			"default": "./dist/editor/index.js"
		},
		"./editor/favicon.svg": "./dist/editor/assets/favicon.svg",
		"./styles.css": "./dist/styles/index.css"
	},
	"files": [
		"dist"
	],
	"peerDependencies": {
		"svelte": "^5.45.6"
	},
	"dependencies": {
		"@fontsource-variable/ibm-plex-sans": "^5.2.8",
		"@fontsource-variable/playpen-sans": "^5.2.9",
		"@inkfinite/core": "workspace:*",
		"@inkfinite/editor": "workspace:*",
		"culori": "^4.0.2"
	},
	"devDependencies": {
		"@iconify-json/bi": "^1.2.7",
		"@iconify-json/ph": "^1.2.2",
		"@iconify-json/tabler": "^1.2.35",
		"@playwright/test": "^1.57.0",
		"@storybook/addon-a11y": "^10.5.2",
		"@storybook/addon-docs": "^10.5.2",
		"@storybook/sveltekit": "^10.5.2",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@vitest/browser-playwright": "^4.0.15",
		"@vitest/coverage-v8": "^4.0.16",
		"@unocss/preset-icons": "^66.7.5",
		"jsdom": "^27.3.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"storybook": "^10.5.2",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"unocss": "^66.7.5",
		"vite": "^7.2.6",
		"vitest": "^4.0.15",
		"vitest-browser-svelte": "^2.0.1"
	}
}
